# Copy to .env and edit; load it with:  set -a; source .env; set +a
# Only the stages that call an LLM need these (retrieval: translation + false-negative audit; rageval: generator + judges).
# Any OpenAI-compatible /chat/completions server works (vLLM, llama.cpp's llama-server, a hosted API ...). The variable
# names are the *roles* used in the experiments; the published numbers were produced with Gemma-4-26B-A4B for GEMMA_*
# and Qwen3-4B-Instruct-2507 for QWEN_*. Requests set chat_template_kwargs.enable_thinking=false (a vLLM / llama.cpp
# extension); a server that rejects unknown fields needs that line removed in rageval/llm.py and retrieval/translate.py.

# primary LLM: query translation, false-negative judge, RAG generator, main judge
GEMMA_BASE_URL=http://localhost:8000/v1
GEMMA_API_KEY=EMPTY
GEMMA_MODEL=gemma4-26b-a4b
GEMMA_SLOTS=2            # hard cap on concurrent requests, enforced across processes

# second judge (a small model is enough; it showed the largest before/after effect of the judge pipeline)
QWEN_BASE_URL=http://localhost:8001/v1
QWEN_API_KEY=EMPTY
QWEN_MODEL=qwen-judge
QWEN_SLOTS=6

# optional
# ARR_RUNS_DIR=/data/arr-runs        # large outputs (default: ./runs)
# ARR_CPU_THREADS=6                  # torch threads for the in-process MiniLM embedder / reranker (rageval)
# HF_HOME=/data/hf                   # Hugging Face download cache
